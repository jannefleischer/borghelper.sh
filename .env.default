# Vorlage fuer die .env-Datei. Kopieren nach .env und mit echten Werten befuellen:
#   cp .env.default .env

# Empfaenger-Adresse fuer Alarm-Mails (fehlgeschlagenes Backup / fehlgeschlagener Neustart des Docker-Stacks)
MAILTO=admin@example.com

# SMTP-Server-Konfiguration fuer den Mail-Versand.
# Wenn SMTP_HOST leer bleibt, wird stattdessen das lokale sendmail verwendet.
# Beispiel: lokaler davmail-Dienst (~/dockerhome/davmail), der als SMTP-Proxy zu Exchange arbeitet.
SMTP_HOST=localhost
SMTP_PORT=1025
# Exchange-Zugangsdaten fuer die Authentifizierung ueber davmail.
# Format: "DOMAIN\username" (NTLM) - unbedingt in Anfuehrungszeichen setzen,
# sonst frisst bash den Backslash beim Einlesen der .env!
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=admin@example.com
# davmail nutzt auf dem Loopback i.d.R. kein vertrauenswuerdiges TLS-Zertifikat -> TLS nicht erzwingen
SMTP_INSECURE=true

# Borg-Repo-Zugangsdaten/-Optionen. Werden an jeden sudo-borg-Aufruf durchgereicht,
# da sudo per default die Umgebung zuruecksetzt. Leer lassen, wenn nicht benoetigt.
# Ist die Variable schon vor dem Start des Scripts gesetzt (z.B. auf der
# Kommandozeile: BORG_PASSPHRASE=... ./startborg.sh ...), hat dieser Wert
# Vorrang vor dem hier aus der .env gelesenen.
BORG_PASSPHRASE=
# "yes" setzen, wenn das Repo an einen anderen Pfad verschoben wurde und Borg das
# ohne Rueckfrage akzeptieren soll. Gilt ebenfalls: ein vorab gesetzter Wert
# hat Vorrang vor der .env.
BORG_RELOCATED_REPO_ACCESS_IS_OK=
